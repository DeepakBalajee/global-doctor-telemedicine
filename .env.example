# GLOBAL DOCTOR APPOINTMENT & TELEMEDICINE PLATFORM
# Production Environment Variable Template (.env.example)

NODE_ENV=production
PORT=3000

# APP URLs (No hardcoded localhost in production)
NEXT_PUBLIC_APP_URL=https://telemed.globaldoctor.org
NEXT_PUBLIC_API_BASE_URL=https://telemed.globaldoctor.org/api

# DATABASE CONFIGURATION
DATABASE_URL=postgresql://telemed_user:your_secure_password_here@localhost:5432/telemed_db?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# AUTHENTICATION & SESSION SECRETS
JWT_SECRET=replace_with_a_min_32_character_random_string_here
SESSION_SECRET=replace_with_another_secure_random_hash_here
COOKIE_DOMAIN=.globaldoctor.org

# PAYMENT GATEWAY (Server-Authoritative ₹5.00 Consultation Fee)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_public_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# WEBRTC VIDEO CONSULTATION INFRASTRUCTURE
NEXT_PUBLIC_VIDEO_SIGNALING_URL=wss://telemed.globaldoctor.org/signal
VIDEO_SERVICE_API_KEY=your_video_service_api_key_here
VIDEO_SERVICE_API_SECRET=your_video_service_secret_here

# EMAIL / NOTIFICATION PROVIDER
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
NOTIFICATION_FROM_EMAIL=noreply@globaldoctor.org

# STORAGE CONFIGURATION (Medical Documents)
STORAGE_BUCKET_NAME=global-telemed-docs-prod
STORAGE_REGION=ap-south-1
